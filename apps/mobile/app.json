{
  "expo": {
    "name": "연애 어시스턴트",
    "slug": "loveassist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loveassist",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.loveassist.app"
    },
    "android": {
      "package": "com.loveassist.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#15131B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15131B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["*/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "앱 잠금을 풀 때 Face ID를 사용해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "카톡 캡처에서 대화를 읽으려고 사진에 접근해요. 사진은 기기 밖으로 보내지 않아요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-hide-recents-preview",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
